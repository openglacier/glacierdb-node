{
  "name": "glacierdb",
  "version": "0.1.0",
  "description": "Zero-dependency Node.js driver for glacierdb (ogd)",
  "homepage": "https://github.com/openglacier/glacierdb-node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openglacier/glacierdb-node.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/msgpack.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "glacierdb",
    "ogd",
    "database",
    "msgpack"
  ],
  "license": "MIT"
}
